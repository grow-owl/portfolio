# Resend Email Service (Free 3,000 emails/month at https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL_TO=hello@growowl.online

# Upstash Redis for Rate Limiting (Free tier at https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Cloudflare Turnstile Anti-Bot Verification (Free at https://dash.cloudflare.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

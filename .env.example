# Resend Email Service (Primary - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL_TO=admin@growowl.online

# Upstash Redis for Rate Limiting (https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Cloudflare Turnstile Anti-Bot Verification (https://dash.cloudflare.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# Brevo SMTP (Fallback Email Service - https://brevo.com)
BREVO_SMTP_KEY=xsmtpsib-your_brevo_smtp_key_here
BREVO_SMTP_USER=admin.growowl@gmail.com
